# UI-only config for tool runs (`bazel run --config=tool @multitool//tools/<tool>:cwd -- ...`), so
# they share every build flag and keep the analysis cache.
common:tool --ui_event_filters=-info --noshow_progress

# Per-user settings (output root, caches, run environment): untracked, absolute paths. Keep last.
try-import %workspace%/user.bazelrc
