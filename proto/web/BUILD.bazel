load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

# gazelle:js_project_naming_convention component
# gazelle:js_tests_naming_convention component_test_lib

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "component",
    srcs = ["component.tsx"],
    declaration = True,
    preserve_jsx = False,
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/react",
        ":node_modules/react",
    ],
)

ts_project(
    name = "component_test_lib",
    testonly = True,
    srcs = ["component.test.tsx"],
    declaration = True,
    preserve_jsx = False,
    tsconfig = ":tsconfig",
    deps = [
        ":component",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
)

js_test(
    name = "component_test",
    data = [":component_test_lib"],
    entry_point = "component.test.js",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
)
