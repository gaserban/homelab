load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# Gazelle names Go targets after the import path's last element: hello, hello_lib, hello_test.
# gazelle:prefix github.com/gaserban/homelab/proto/hello

go_library(
    name = "hello_lib",
    srcs = ["hello.go"],
    importpath = "github.com/gaserban/homelab/proto/hello",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "hello",
    embed = [":hello_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "hello_test",
    srcs = ["hello_test.go"],
    embed = [":hello_lib"],
)
