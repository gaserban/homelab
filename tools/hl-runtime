#!/usr/bin/env bash
# hl-runtime CMD...: run CMD against the dev runtime (ADR 0005): the homelab-runtime user's rootless
# Podman API, the kind API server and the registry, all listening on host loopback.
# The Claude Code sandbox has its own network namespace and Go never proxies loopback, so inside it
# each port is bridged through the sandbox proxy for the life of CMD. Outside it, CMD connects directly.
set -euo pipefail

PODMAN_API_PORT=8888
BRIDGED_PORTS=(8888 6443 5001)   # Podman API, kind API server, registry
repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

export CONTAINER_HOST="tcp://127.0.0.1:$PODMAN_API_PORT"   # podman, and kind through it, run remote
export KIND_EXPERIMENTAL_PROVIDER=podman
export KUBECONFIG="${KUBECONFIG:-$repo/.state/kubeconfig}"
mkdir -p "$(dirname "$KUBECONFIG")"
# The podman client wants a writable runtime dir even in remote mode.
if [[ ! -w "${XDG_RUNTIME_DIR:-/nonexistent}" ]]; then
  export XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/hl-runtime"
  mkdir -p "$XDG_RUNTIME_DIR"
fi

reachable() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

pids=()
if ! reachable "$PODMAN_API_PORT"; then
  proxy=${HTTP_PROXY:-${http_proxy:-}}
  if [[ -z "$proxy" ]]; then
    echo "hl-runtime: nothing on 127.0.0.1:$PODMAN_API_PORT; is homelab-podman-api.service running?" >&2
    exit 1
  fi
  hostport=${proxy#*://}; hostport=${hostport%/}; auth=""
  if [[ "$hostport" == *@* ]]; then auth=${hostport%@*}; hostport=${hostport##*@}; fi
  for p in "${BRIDGED_PORTS[@]}"; do
    socat "TCP-LISTEN:$p,bind=127.0.0.1,fork,reuseaddr" \
      "PROXY:${hostport%:*}:127.0.0.1:$p,proxyport=${hostport##*:}${auth:+,proxyauth=$auth}" 2>/dev/null &
    pids+=("$!")
  done
  trap 'kill "${pids[@]}" 2>/dev/null || true' EXIT
  for _ in $(seq 50); do reachable "$PODMAN_API_PORT" && break; sleep 0.1; done
fi

"$@"
