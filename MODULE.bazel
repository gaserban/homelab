"""Spike for #19 (never merged): one Bazel graph for every language this repo will hold."""

module(name = "homelab")

bazel_dep(name = "platforms", version = "1.1.0")

# C and C++: Zig ships libc, so no host compiler or sysroot is needed (the host has none).
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains("@zig_sdk//toolchain/...")

# Go
bazel_dep(name = "rules_go", version = "0.65.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
# Hashes pinned here, so rules_go does not fetch go.dev's version index (not allowlisted).
go_sdk.download(
    sdks = {
        "linux_amd64": ("go1.27.3.linux-amd64.tar.gz", "65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40"),
        "linux_arm64": ("go1.27.3.linux-arm64.tar.gz", "a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49"),
    },
    version = "1.27.3",
)

# Single-binary tools, run as `bazel run --config=tool @multitool//tools/<tool>:cwd -- <args>`.
# The root module's lock wins over a dependency's (rules_uv pins an older uv).
bazel_dep(name = "rules_multitool", version = "1.11.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:multitool.lock.json")
use_repo(multitool, "multitool")

# Python: rules_uv compiles proto/py/pyproject.toml into a hashed requirements.txt (and a diff test)
# for rules_python's pip.parse.
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "rules_uv", version = "0.89.2")

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    download_only = True,
    hub_name = "pypi",
    python_version = "3.14",
    requirements_lock = "//proto/py:requirements.txt",
)
use_repo(pip, "pypi")

# JavaScript and TypeScript: Aspect rules_js reads pnpm-lock.yaml; rules_ts compiles with tsc.
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "26.12.1")
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version_from = "//:package.json",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version_from = "//proto/web:package.json")
use_repo(typescript, "npm_typescript")
