# Claude Code: personal and runtime state
CLAUDE.local.md
.claude/settings.local.json
.flow/
# Never commit secrets or keys
*.pem
*.key
.env
.env.*
# Personal shell and editor files: never belong in a repo; the sandbox masks these paths too
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.ripgreprc
.idea
.vscode
# Claude Code per-user runtime state (agents, commands, workflows and .mcp.json stay tracked)
.claude/launch.json
.claude/loop.md
.claude/routines
.claude/scheduled_tasks.json
.claude/output-styles
# Downloaded skills: restored from skills-lock.json at session start (ADR 0017); only our own hl-
# skills are tracked
.claude/skills/*
!.claude/skills/hl-*/
